{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "production": {
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "android": {
        "autoIncrement": true
      }
    },
    "preview-test": {
      "extends": "preview",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "test"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
